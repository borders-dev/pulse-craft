{
  "name": "ledgehq/ledge-craft",
  "description": "Health, uptime, and compliance monitoring for your Craft CMS sites.",
  "type": "craft-plugin",
  "license": "mit",
  "support": {
    "email": "hello@ledgehq.app",
    "issues": "https://github.com/ledge-hq/ledge-craft/issues?state=open",
    "source": "https://github.com/ledge-hq/ledge-craft",
    "docs": "https://github.com/ledge-hq/ledge-craft",
    "rss": "https://github.com/ledge-hq/ledge-craft/releases.atom"
  },
  "require": {
    "php": ">=8.0.2",
    "craftcms/cms": "^4.0 || ^5.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "bordersdev\\craftpulse\\": "src/"
    }
  },
  "extra": {
    "handle": "pulse",
    "name": "Pulse",
    "developer": "Ledge HQ",
    "documentationUrl": "https://github.com/ledge-hq/ledge-craft",
    "class": "bordersdev\\craftpulse\\Pulse"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.0.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
